# Copy to .env (project root). The web server and CLI both read it.
# Without a key, /api/ask still works — it falls back to deterministic
# template prose instead of Claude-written rationale + clarifying questions.
ANTHROPIC_API_KEY=

# ── Jira ingest — connect any Jira instance ──────────────────────────────────
# All commented out by default: with none set, ingest targets Apache Kafka's
# public Jira (no auth needed) — the demo dataset. Uncomment to point elsewhere.
# Jira instance URL
# JIRA_BASE_URL=https://your-org.atlassian.net
# Project key to ingest (default: KAFKA)
# JIRA_PROJECT=MYPROJECT
# API type override — auto-detected from baseUrl (.atlassian.net → cloud, else server)
# JIRA_API=cloud   # or: server
# Cloud auth: email + API token (generate at id.atlassian.com → Security → API tokens)
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your-api-token-here
# Server/DC auth: Personal Access Token (generate in Jira → Profile → Personal Access Tokens)
# JIRA_PAT=your-personal-access-token
# Custom JQL overrides (optional — sensible defaults are built in)
# JIRA_JQL_RESOLVED=project = MYPROJECT AND resolutiondate is not EMPTY AND assignee is not EMPTY ORDER BY resolved DESC
# JIRA_JQL_OPEN=project = MYPROJECT AND resolutiondate is EMPTY AND statusCategory = "In Progress" AND assignee is not EMPTY ORDER BY updated DESC
# Disable pseudonymization to store real names (safe for your own team's data)
# PSEUDONYMIZE=false

# ── Jira OAuth 2.0 (3LO) — Cloud only ────────────────────────────────────────
# Register an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
# Add the "Jira platform REST API" with scopes: read:jira-work read:jira-user offline_access
# Then copy the Client ID and Secret here and visit /connect to authorize.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# Optional: override the redirect URI (defaults to http://localhost:3000/api/auth/jira/callback)
JIRA_OAUTH_REDIRECT_URI=

# ── GitHub App — private repo access ─────────────────────────────────────────
# Register a GitHub App (see docs/GITHUB_APP_SETUP.md for click-by-click steps).
# One org admin installs it on chosen repos; no long-lived tokens are stored.
#
# Numeric App ID — shown at the top of the App's settings page.
GITHUB_APP_ID=
# App slug — the URL identifier used in github.com/apps/<slug>.
# Used to build the "Install GitHub App" link in the UI.
GITHUB_APP_SLUG=
# Path to the RSA private key PEM downloaded from the App settings page.
# Store the file inside the project (e.g. data/github-app.pem) — never commit it.
# Default: data/github-app.pem (relative to the project root)
GITHUB_APP_PRIVATE_KEY_PATH=data/github-app.pem
